{
  "schema_version": 1,
  "kind": "comfyui_workflow_overlay",
  "purpose": "Apply to each Continuum chunk's existing base-plus-refine graph",
  "shared_handle": {
    "node": "H3FlowTrajectory",
    "widgets": {"storage": "system_ram", "max_runs": 8}
  },
  "base_model_patch": {
    "node": "H3TrajectoryCapture",
    "inputs": {"trajectory": "shared_handle"},
    "widgets": {"capture_forecasts": false},
    "placement": "after chunk-local MODEL patches and before base KSampler"
  },
  "high_model_patch": {
    "node": "H3FlowAlignedRegenerate",
    "inputs": {"trajectory": "shared_handle"},
    "widgets": {
      "guidance_mode": "direction",
      "direction_weight": 0.35,
      "acceleration_weight": 0.0,
      "consistency_weight": 0.0,
      "low_frequency_cutoff": 0.25
    },
    "placement": "after learned-upscaler chunk MODEL output and before refine KSampler"
  },
  "invariants": {
    "audio": "locked_by_existing_refine_graph",
    "target_pixels": [1024, 768],
    "target_latent_wh": [64, 48],
    "forecast_anchors": false,
    "decoded_media_required": true
  }
}
