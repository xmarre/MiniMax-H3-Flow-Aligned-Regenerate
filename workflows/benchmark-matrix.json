    {"id": "C6", "mode": "flow_aligned", "source_grid": [54, 40], "target_grid": [64, 48], "outer_steps": 6, "denoise": 0.25},
    {"id": "C5", "mode": "flow_aligned", "source_grid": [54, 40], "target_grid": [64, 48], "outer_steps": 5, "denoise": 0.25},
    {"id": "C4", "mode": "flow_aligned", "source_grid": [54, 40], "target_grid": [64, 48], "outer_steps": 4, "denoise": 0.25},
    {"id": "D", "mode": "progressive_handoff", "source_grid": [54, 40], "target_grid": [64, 48], "handoff_coordinate": 0.35},
