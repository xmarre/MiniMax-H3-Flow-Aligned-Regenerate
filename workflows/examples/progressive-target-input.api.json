    "class_type": "H3ProgressiveTargetInputHandoff",
    "_meta": {"title": "Progressive Handoff (Target Input)"}
  },
  "8": {
    "inputs": {"noise_seed": 424242},
    "class_type": "RandomNoise",
    "_meta": {"title": "Noise"}
  },
  "9": {
    "inputs": {"sampler_name": "res_multistep"},
    "class_type": "KSamplerSelect",
    "_meta": {"title": "Sampler"}
  },
  "10": {
    "inputs": {
      "scheduler": "simple",
      "steps": 19,
      "denoise": 1.0,
      "model": ["7", 0]
    },
    "class_type": "BasicScheduler",
    "_meta": {"title": "19-step schedule"}
  },
  "11": {
    "inputs": {
      "model": ["7", 0],
      "conditioning": ["5", 0]
    },
    "class_type": "BasicGuider",
    "_meta": {"title": "Basic Guider"}
