  "5": {
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "A single continuous cinematic shot of a cyclist crossing a wet city street at dusk. The camera tracks smoothly from the side while reflections move across the pavement. Natural traffic ambience and bicycle sounds, no cuts, no text or subtitles.",
      "width": 1152,
      "height": 640,
      "length": 124
    },
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": {"title": "MiniMax H3 conditioning + target-grid latent"}
  },
  "6": {
    "inputs": {"storage": "system_ram", "max_runs": 4},
